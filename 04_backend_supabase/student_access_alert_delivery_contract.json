  "purpose": "Repository-first external alert-delivery contract for high/critical student-access abuse signals. It defines a concrete zero-cost-capable Telegram Bot API adapter and a receipt-bearing controlled-signal proof without deploying, configuring secrets, creating synthetic signals, or promoting incident-response readiness in this stage.",
  "producer_contract": {
    "signal_table": "private.student_access_security_signals",
    "supported_signal_types": [
      "rate_limit_burst",
      "command_replay_burst",
      "token_rotation_burst",
      "network_rate_limit_burst"
    ],
    "deliver_severities": ["high", "critical"],
    "medium_delivery_required": false,
    "network_rate_limit_burst_is_high": true,
    "provider_delivery_must_not_block_student_request_path": true,
    "provider_failure_must_not_regrant_or_bypass_security_controls": true
  },
  "provider_contract": {
    "provider": "telegram_bot_api",
    "delivery_method": "HTTPS_POST_sendMessage",
    "base_url": "https://api.telegram.org",
    "endpoint_template": "/bot<secret-token>/sendMessage",
    "cost_model": "no_paid_provider_required_for_initial_contract",
    "destination_is_runtime_secret": true,
    "public_marketing_channel_is_not_assumed": true,
    "required_runtime_secrets": [
      "STUDENT_ACCESS_ALERT_TELEGRAM_BOT_TOKEN",
