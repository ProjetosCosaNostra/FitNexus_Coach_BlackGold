    ],
    "secrets_must_not_exist_in_repository": true,
    "secrets_must_not_be_logged": true,
    "chat_id_must_not_be_hardcoded": true
  },
  "payload_contract": {
    "format": "plain_text",
    "required_fields": [
      "system",
      "environment",
      "signal_id",
      "signal_type",
      "severity",
      "operation",
      "event_count",
      "window_started_at",
      "first_seen_at",
      "last_seen_at",
      "controlled_proof_marker"
