{
  "schema_version": 1,
  "kind": "NON_ATTESTING_SIGNED_AAB_RUNNER_CONTRACT",
  "project": "FitNexus Coach BlackGold",
  "runner": {
    "path": "tool/FITNEXUS_PLAY_SIGNED_AAB_RUNNER_V1.ps1",
    "single_command_required": true,
    "platform": "Windows PowerShell",
    "validate_only_mode_required": true
  },
  "secret_boundary": {
    "upload_key_repository_storage_allowed": false,
    "plaintext_password_repository_storage_allowed": false,
    "key_properties_must_be_gitignored": true,
    "persistent_keystore_location": "%USERPROFILE%/Documents/FitNexus_Coach_BlackGold_EXTERNAL/play_signing/authority",
    "persistent_password_storage": "WINDOWS_DPAPI_CURRENT_USER",
    "transient_key_properties_cleanup_required": true
  },
  "build_pipeline": {
    "flutter_pub_get": true,
    "play_preflight_inventory": true,
    "flutter_analyze": true,
    "flutter_test": true,
    "flutter_build_appbundle_release": true,
    "jarsigner_verification": true,
    "sha256_receipt": true,
    "current_only_receipt_directory": true
  },
  "publication_boundary": {
    "signed_aab_proof_is_play_upload_authority": false,
    "play_console_uniqueness_still_required": true,
    "play_app_signing_enrollment_still_required": true,
    "play_upload_performed_by_runner": false,
    "production_release_performed_by_runner": false
  }
}
